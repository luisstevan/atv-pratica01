{
  "info": {
    "name": "Gestão Financeira API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection para testar a API do projeto de Gestão Financeira."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "incomeCategoryId",
      "value": ""
    },
    {
      "key": "customCategoryId",
      "value": ""
    },
    {
      "key": "transactionId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health-check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"luis@iesb.com\",\n  \"password\": \"123456\"\n}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Listar categorias",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "const income = json.find(c => c.name === 'income');",
              "if (income) pm.collectionVariables.set('incomeCategoryId', income.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/categories"
      }
    },
    {
      "name": "Criar categoria",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('customCategoryId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"health\",\n  \"displayName\": \"Saúde\",\n  \"icon\": \"favorite\",\n  \"background\": \"#FFB6B6\",\n  \"isIncome\": false\n}"
        },
        "url": "{{baseUrl}}/categories"
      }
    },
    {
      "name": "Atualizar categoria",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"displayName\": \"Saúde e Bem-estar\"}"
        },
        "url": "{{baseUrl}}/categories/{{customCategoryId}}"
      }
    },
    {
      "name": "Excluir categoria customizada",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/categories/{{customCategoryId}}"
      }
    },
    {
      "name": "Tentar excluir categoria padrão",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/categories/{{incomeCategoryId}}"
      }
    },
    {
      "name": "Criar transação",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('transactionId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Salário de outubro\",\n  \"value\": 3500.5,\n  \"date\": \"2026-04-29\",\n  \"categoryId\": \"{{incomeCategoryId}}\"\n}"
        },
        "url": "{{baseUrl}}/transactions"
      }
    },
    {
      "name": "Listar transações",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/transactions"
      }
    },
    {
      "name": "Atualizar transação",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Salário de outubro atualizado\",\n  \"value\": 3600.5\n}"
        },
        "url": "{{baseUrl}}/transactions/{{transactionId}}"
      }
    },
    {
      "name": "Excluir transação",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/transactions/{{transactionId}}"
      }
    },
    {
      "name": "Validar erro Zod",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"description\": \"\"}"
        },
        "url": "{{baseUrl}}/transactions"
      }
    }
  ]
}